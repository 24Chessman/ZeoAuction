# Copy to .env.local. With VITE_USE_MOCKS=true (the default) the app runs entirely in the browser
# against an in-memory simulation of the services, seeded with the same accounts as
# infra/postgres/seed/dev-seed.sql (password: zeo-dev-password).
VITE_USE_MOCKS=true

# Point at the running stack (docker compose up): set VITE_USE_MOCKS=false.
# The services must allow this origin: CORS_ALLOW_ORIGINS=http://localhost:5173
VITE_AUTH_URL=http://localhost:8001
VITE_KYC_URL=http://localhost:8002
VITE_AUCTION_URL=http://localhost:8003
VITE_BID_URL=http://localhost:8004
VITE_PAYMENT_URL=http://localhost:8006
VITE_WS_URL=ws://localhost:8010/ws

# Comma-separated auction ids shown on the browse page in live mode (there is no list endpoint
# before search-analytics lands in Plan 6). Defaults to the seeded auction.
VITE_FEATURED_AUCTIONS=00000000-0000-4000-8000-000000000201

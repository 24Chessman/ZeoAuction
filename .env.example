# Copy to .env to override docker-compose defaults. Local development values only;
# hosted values live in Render environment groups, never in the repository.

POSTGRES_PASSWORD=postgres
LOG_LEVEL=INFO

# Payment adapter: "mock" until ADR-0009 is accepted and the provider adapter lands (Plan 4).
PAYMENT_ADAPTER=mock

# Shared access-token secret for every service. Any long random string locally.
JWT_SECRET=zeo-dev-jwt-secret-not-for-production-use

# Origins allowed to call the APIs from a browser (the Vite dev server).
CORS_ALLOW_ORIGINS=http://localhost:5173

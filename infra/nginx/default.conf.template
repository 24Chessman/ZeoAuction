map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Dynamic CORS origin mapping (Local dev, Vercel frontend, Render services)
map $http_origin $cors_origin {
    default "";
    "~^https?://localhost(:[0-9]+)?$" "$http_origin";
    "~^https?://127\.0\.0\.1(:[0-9]+)?$" "$http_origin";
    "~^https://.*\.vercel\.app$" "$http_origin";
    "~^https://.*\.onrender\.com$" "$http_origin";
}

log_format upstream_fmt '[$time_local] "$request" $status '
                       'upstream=$upstream_addr status=$upstream_status '
                       'rt=$request_time urt=$upstream_response_time '
                       'origin="$http_origin"';

server {
    listen 80;
    server_name _;

    client_max_body_size 10m;
    access_log /dev/stdout upstream_fmt;
    error_log /dev/stderr info;

    # Intercept upstream 502, 503, 504 errors and return clean JSON with CORS
    error_page 502 503 504 = @service_unavailable;

    location @service_unavailable {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' $cors_origin always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Expose-Headers' 'X-Request-ID, Idempotent-Replay' always;
        return 503 '{"code":"SERVICE_UNAVAILABLE","message":"Backend service is temporarily unavailable or warming up. Please retry in a few seconds.","details":null}\n';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /readyz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # This more-specific route must precede the generic auction route.
    location ~ ^/api/v1/auctions/[^/]+/bids(?:/|$) {
        proxy_pass ${BID_URL};
        include /etc/nginx/proxy_params;
    }

    # Payment owns the per-auction order resource. This must appear before the
    # generic auction route below, otherwise Nginx proxies it to Orchestration
    # and callers see a misleading 404 even when the invoice exists.
    location ~ ^/api/v1/auctions/[^/]+/order(?:/|$) {
        proxy_pass ${PAYMENT_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/auth/ {
        proxy_pass ${AUTH_USER_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/users/ {
        proxy_pass ${AUTH_USER_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/kyc/ {
        proxy_pass ${KYC_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/admin/kyc/ {
        proxy_pass ${KYC_URL};
        include /etc/nginx/proxy_params;
    }

    # Nginx automatically redirects the slashless collection path when only the
    # trailing-slash proxy location exists. CORS preflight requests must not be redirected.
    location = /api/v1/auctions {
        proxy_pass ${AUCTION_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/auctions/ {
        proxy_pass ${AUCTION_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/pricing/ {
        proxy_pass ${PRICING_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/fees/ {
        proxy_pass ${PAYMENT_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/orders/ {
        proxy_pass ${PAYMENT_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/webhooks/ {
        proxy_pass ${PAYMENT_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/disputes/ {
        proxy_pass ${DISPUTE_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/search/ {
        proxy_pass ${SEARCH_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/admin/ {
        proxy_pass ${ADMIN_URL};
        include /etc/nginx/proxy_params;
    }

    location /api/v1/bids/ {
        proxy_pass ${BID_URL};
        include /etc/nginx/proxy_params;
    }

    location /ws {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass ${WS_GATEWAY_URL};
    }

    location / {
        add_header 'Access-Control-Allow-Origin' $cors_origin always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        default_type application/json;
        return 404 '{"code":"NOT_FOUND","message":"Gateway route not found"}';
    }
}

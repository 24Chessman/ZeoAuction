# Copy to .env.local. With ZEO_USE_MOCKS=true (the default) the app runs entirely in the browser
# against an in-memory simulation of the services, seeded with the same accounts as
# infra/postgres/seed/dev-seed.sql (password: zeo-dev-password).
ZEO_USE_MOCKS=true

# Point at the running stack (docker compose up): set ZEO_USE_MOCKS=false.
# The services must allow this origin: CORS_ALLOW_ORIGINS=http://localhost:5173
# In Render/Production, set ZEO_API_GATEWAY_URL (or ZEO_API_URL) to the public Nginx gateway URL.
# Individual service URLs below remain available as local-development overrides.
ZEO_API_GATEWAY_URL=
ZEO_API_URL=
ZEO_AUTH_URL=http://localhost:8001
ZEO_KYC_URL=http://localhost:8002
ZEO_AUCTION_URL=http://localhost:8003
ZEO_BID_URL=http://localhost:8004
ZEO_PAYMENT_URL=http://localhost:8006
ZEO_WS_URL=ws://localhost:8010/ws

# Payments (ADR-0009): with ZEO_USE_MOCKS=false, "Pay now" opens Razorpay Checkout in test mode when the
# stack runs with PAYMENT_ADAPTER=razorpay (keys in the repository's .env), or a simulated Checkout with
# the default mock adapter. The browser only ever sees the public rzp_test_ key id.
# With ZEO_USE_MOCKS=true, `npm run dev` also uses real Razorpay test mode when the repository's .env has
# RAZORPAY_KEY_ID=rzp_test_... and RAZORPAY_KEY_SECRET: the dev server (dev/razorpayBridge.ts) creates the
# order and captures the payment, so the secret stays in Node. Without those keys, Checkout is simulated.

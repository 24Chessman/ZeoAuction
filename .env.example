# Copy to .env to override docker-compose defaults. Local development values only;
# hosted values live in Render environment groups, never in the repository.

POSTGRES_PASSWORD=postgres
LOG_LEVEL=INFO

# Payment adapter (ADR-0009): "mock" (default, offline) or "razorpay" (TEST MODE ONLY).
# For razorpay, create test keys at https://dashboard.razorpay.com (Test Mode), and a webhook
# pointing at <public-url>/api/v1/webhooks/razorpay with the event payment.authorized. The
# adapter refuses anything but a rzp_test_ key. Never commit real values.
PAYMENT_ADAPTER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Route linked account (acc_...) that receives every seller payout in test mode.
RAZORPAY_LINKED_ACCOUNT=

# Token Auction Orchestration presents on Payment's internal settlement route (CT-4).
INTERNAL_SERVICE_TOKEN=zeo-dev-internal-token-not-for-production

# Shared access-token secret for every service. Any long random string locally.
JWT_SECRET=zeo-dev-jwt-secret-not-for-production-use

# Origins allowed to call the APIs from a browser (the Vite dev server).
CORS_ALLOW_ORIGINS=http://localhost:5173
